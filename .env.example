# settings for docker-compose.yml; copy to .env

# the corpus to serve, e.g. ./data/5y after import_snapshot.py
DATA_PATH=./data
# where the proxy reaches the web service
BIND=127.0.0.1
PORT=8000
# run as this user, so files in DATA_PATH stay yours (`id -u`, `id -g`)
UID=1000
GID=1000

# 0 = only accounts made with `docker compose exec web flask --app serve set-password <user>`
ALLOW_SIGNUP=1
# workers share the (memory-mapped) features; each adds ~0.5GB on 5 years of papers
WEB_WORKERS=2
WEB_THREADS=4
# papers per day that "add papers" may fetch from arXiv, per user and in total
FETCH_LIMIT_USER=200
FETCH_LIMIT_TOTAL=2000

# the embedding model the features were computed with; empty for tfidf only
EMBED_MODEL=st:google/embeddinggemma-2
# a Hugging Face token, only needed for gated models (embeddinggemma-2 isn't)
HF_TOKEN=
COMPUTE_ARGS=--max_docs 100000
UPDATE_INTERVAL=86400
# features for papers added on the website, at most this often (seconds)
COMPUTE_MIN_INTERVAL=3600

# weekly digest emails, with links to PUBLIC_URL. keep 0 (off) until the mail DNS records
# are set and a test digest passes; with 1 the first one goes out at the next slot
DIGEST_ENABLED=0
# day, time and timezone of the weekly send (local time, summer time included)
DIGEST_SCHEDULE=sun 08:00 Europe/Berlin
PUBLIC_URL=https://sanity.example.org
MAIL_FROM=Arxiv Resanity <digest@example.org>
# self-hosted sending: the `mail` service (outgoing postfix + dkim). its first start prints
# the DNS records to set. MAIL_HOSTNAME must match the VPS's reverse DNS
COMPOSE_PROFILES=mail
MAIL_DOMAIN=example.org
MAIL_HOSTNAME=vps.example.org
# or send through any SMTP server instead (then drop COMPOSE_PROFILES=mail):
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=...
# SMTP_PASSWORD=...
